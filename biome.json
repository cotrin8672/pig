{
  "$schema": "https://biomejs.dev/schemas/2.4.8/schema.json",
  "files": {
    "includes": [
      "**",
      "!!**/.hutch",
      "!!**/.cottontail-tmp",
      "!!**/dist",
      "!!**/build",
      "!!**/artifacts",
      "!!apps/desktop/src-tauri/gen",
      "!!apps/desktop/src-tauri/target",
      "!!examples/remote-pairing-poc/target",
      "!!pnpm-lock.yaml",
      "!!**/tokens.css"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2 },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": {
        "noLabelWithoutControl": {
          "level": "error",
          "options": {
            "inputComponents": ["Checkbox", "Switch", "TextField", "Select"]
          }
        }
      }
    }
  },
  "css": { "parser": { "tailwindDirectives": true } }
}
