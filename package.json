{
  "name": "pig",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "pnpm --filter @pig/desktop dev",
    "build": "pnpm --filter @pig/desktop build",
    "typecheck": "pnpm --filter @pig/desktop typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test --parallel=4 apps/desktop/src"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.8"
  }
}
