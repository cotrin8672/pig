{
  "name": "pig",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "pnpm --filter @pig/desktop dev",
    "build": "pnpm --filter @pig/desktop build",
    "typecheck": "pnpm --filter @pig/desktop typecheck",
    "lint": "biome check . && pnpm lint:ui",
    "lint:ui": "bun apps/desktop/scripts/check-ui-styles.ts",
    "format": "biome check --write .",
    "test": "bun apps/desktop/scripts/run-tests.ts unit",
    "test:integration": "bun apps/desktop/scripts/run-tests.ts integration",
    "test:ui": "bun apps/desktop/scripts/check-ui.ts",
    "test:all": "pnpm test && pnpm test:integration && pnpm test:ui"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.8",
    "postcss": "8.5.32",
    "postcss-selector-parser": "7.1.0"
  }
}
